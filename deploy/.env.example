# External PostgreSQL DSN (platform PostgreSQL 18 on the LAN; the role and database are provisioned by the platform owner).
# Percent-encode reserved characters in the password (@ -> %40, / -> %2F, # -> %23).
# host.docker.internal reaches a database on the docker host itself.
MMATH_DATABASE_URL=postgresql+psycopg://mmath:replace-with-password@db.example.lan:5432/mmath
# public: HTTPS origin served by the external Traefik. lan-http: explicit http:// origin on the LAN.
MMATH_MODE=public
MMATH_ORIGIN=https://mmath.example.org
# Public mode only: the external Traefik docker network, the alias its dynamic config points to, and the CIDR of that
# network so the edge keeps the forwarded client address (docker network inspect proxy-net shows the subnet).
TRAEFIK_NETWORK=proxy-net
MMATH_EDGE_ALIAS=mmath-web
MMATH_TRUSTED_PROXIES=172.18.0.0/16
# LAN mode only: where the edge is published.
MMATH_LAN_BIND=127.0.0.1
MMATH_LAN_PORT=8080
# Shadow and active policy (deploy/compose.shadow.yaml, deploy/compose.active.yaml): Framework GPU Tools base URL, alias and host path of the token file.
MMATH_FRAMEWORK_URL=https://framework.example.org
MMATH_FRAMEWORK_MODEL=laya-auto
MMATH_FRAMEWORK_TOKEN_PATH=/opt/minipc-traefik/mmath/framework_edge_token
# Active policy only: verified confidence threshold (0.5-1.0; 0.8 is the proposed value) and the recorded rollout decision.
# MMATH_ACTIVE_CONFIDENCE_THRESHOLD=0.8
# MMATH_ACTIVE_ROLLOUT_AUTHORIZATION=mmath/reference/tasks/<topic>#<decision-event-id>
