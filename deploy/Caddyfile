# Forwarded client addresses are trusted only from MMATH_TRUSTED_PROXIES (the external Traefik's network in public
# mode). Unset it in LAN mode: the default trusts nobody but the loopback, so a LAN client cannot spoof its address.
{
    servers {
        trusted_proxies static {$MMATH_TRUSTED_PROXIES:127.0.0.1}
        client_ip_headers X-Forwarded-For
    }
}
:80 {
    root * /srv
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /sw.js {
        header Cache-Control "no-cache"
        file_server
    }
    handle /manifest.webmanifest {
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
